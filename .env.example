# copy this to .env and fill it in

PORT=3000
# leave NODE_ENV out on vercel, it gets detected
NODE_ENV=development

# mongodb atlas connection string, with the database name before the "?"
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/basecampy?retryWrites=true&w=majority

# where the app lives, used for links in emails and for the oauth callbacks
# local: http://localhost:5173    vercel: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# only needed if the frontend is hosted on a different domain (comma separated, no trailing slash)
CORS_ORIGIN=

# use long random strings, a different one for each. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=7d

# google / github login (optional, leave a pair empty to hide that button)
# callback urls to register:
#   <FRONTEND_URL>/api/v1/auth/oauth/google/callback
#   <FRONTEND_URL>/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# email, any smtp provider works (the names say mailtrap because that's what it started with)
# with the host empty, links get printed in the terminal instead of emailed
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
MAIL_FROM="BaseCampy <no-reply@example.com>"
